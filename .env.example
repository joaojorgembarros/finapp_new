# =============================================================================
# DESENVOLVIMENTO LOCAL — NÃO É CONFIGURAÇÃO DE PRODUÇÃO
# =============================================================================
# Este arquivo é só um exemplo para rodar o app no computador/celular com o
# Supabase local (Docker). Não copie estes valores para TestFlight, APK ou EAS.
#
# Como usar:
# 1. Copie para `.env.development.local` (arquivo local, NÃO commitar).
# 2. O celular precisa estar na mesma rede Wi-Fi do computador.
# 3. Substitua SEU_IP_LAN pelo IPv4 da máquina (ipconfig / ifconfig).
# 4. Rode `npm run db:start` e depois `npm run db:status`.
# 5. Use a anon key do Supabase LOCAL mostrada pelo `db:status`.
#
# `.env.development.local`, `.env.local` e `.env.production` não devem ir para o Git.
#
# Produção / TestFlight / EAS Build usam variáveis do EAS (environment production),
# nunca localhost, 127.0.0.1 ou IP LAN (192.168.x.x).
#
# Scheme do app: sonhomais
# Callback OAuth de produção: sonhomais://auth/callback
# Reset de senha: sonhomais://reset-password
# =============================================================================

# DESENVOLVIMENTO LOCAL
# O celular precisa estar na mesma rede Wi-Fi do computador.
# Substitua SEU_IP_LAN pelo IPv4 da máquina.
EXPO_PUBLIC_SUPABASE_URL=http://SEU_IP_LAN:54321

# Rode `npm run db:status` e use a anon key do Supabase local.
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_LOCAL
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA_PUBLISHABLE_KEY_LOCAL

EXPO_PUBLIC_TERMS_URL=https://joaojorgembarros.github.io/finapp_new/termos/
EXPO_PUBLIC_PRIVACY_URL=https://joaojorgembarros.github.io/finapp_new/privacidade/
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://joaojorgembarros.github.io/finapp_new/exclusao-de-conta/
