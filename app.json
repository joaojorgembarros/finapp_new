{
  "expo": {
    "name": "Sonho+",
    "slug": "finapp-zero-newdb",
    "scheme": "sonhomais",
    "version": "1.0.2",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06152e",
          "image": "./assets/splash-lockup.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#06152e",
            "image": "./assets/splash-android-neutral.png",
            "imageWidth": 16,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Sonho+ acessa suas fotos para você escolher a imagem principal dos seus sonhos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o Sonho+ use o Face ID para proteger seus dados financeiros."
        }
      ],
      "expo-web-browser"
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.joaojorgembarros.sonhomais",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#06152e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.joaojorgembarros.finapp",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f8fafc",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f8fafc",
      "enforceContrast": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c78617fc-5083-4789-b99c-acd66cafef81"
      }
    },
    "owner": "joaojorge30"
  }
}
