{
  "expo": {
    "name": "FinApp",
    "slug": "finapp-zero-newdb",
    "scheme": "finapp",
    "version": "1.0.2",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "O FinApp acessa suas fotos para você escolher a imagem principal dos seus sonhos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070a12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joaojorgembarros.finapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#070a12"
      },
      "package": "com.joaojorgembarros.finapp",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f8fafc",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f8fafc",
      "enforceContrast": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c78617fc-5083-4789-b99c-acd66cafef81"
      }
    },
    "owner": "joaojorge30"
  }
}
